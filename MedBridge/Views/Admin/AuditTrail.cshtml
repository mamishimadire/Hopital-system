@using MedBridge.Models
@model IEnumerable<AuditLog>
@{
    Layout = "_Layout";
    ViewData["Title"] = "Audit Trail";
    int pg      = ViewBag.Page    ?? 1;
    int total   = ViewBag.Total   ?? 0;
    int perPage = ViewBag.PerPage ?? 50;
    int pages   = (int)Math.Ceiling((double)total / perPage);
}

<div class="page-header">
    <div>
        <h1 class="page-heading">Audit Trail</h1>
        <p class="page-subheading">Immutable log of all system actions — @total entries</p>
    </div>
    <a asp-action="Blockchain" class="btn btn-outline">🔗 Blockchain View</a>
</div>

<!-- Filters -->
<form method="get" asp-action="AuditTrail">
    <div class="filter-bar">
        <div class="search-box">
            <input type="text" name="search" value="@ViewBag.Search" placeholder="Search action or user…" />
            <button type="submit">🔍</button>
        </div>
        @if (!string.IsNullOrEmpty(ViewBag.Search as string))
        {
            <a asp-action="AuditTrail" class="btn btn-outline btn-sm">Clear</a>
        }
    </div>
</form>

<div class="card">
    @if (Model.Any())
    {
        <div class="table-container">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Timestamp</th>
                        <th>User</th>
                        <th>Role</th>
                        <th>Action</th>
                        <th>Entity</th>
                        <th>Block Hash</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var log in Model)
                    {
                        <tr>
                            <td style="font-size: 11px; color: var(--text-muted);">@log.Id</td>
                            <td style="font-size: 12px; white-space: nowrap;">
                                @log.Timestamp.ToLocalTime().ToString("dd MMM yy")
                                <div style="color: var(--text-muted);">@log.Timestamp.ToLocalTime().ToString("HH:mm:ss")</div>
                            </td>
                            <td>
                                <div style="font-weight: 500; font-size: 13px;">@log.UserName</div>
                                @if (!string.IsNullOrEmpty(log.UserId) && log.UserId.Length >= 8)
                                {
                                    <div style="font-size: 11px; color: var(--text-muted);">@log.UserId.Substring(0, 8)…</div>
                                }
                            </td>
                            <td><span class="role-badge role-@(log.Role?.ToLower() ?? "user")">@log.Role</span></td>
                            <td style="font-size: 13px; font-weight: 500; max-width: 280px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;"
                                title="@log.Action">@log.Action</td>
                            <td style="font-size: 12px; color: var(--text-muted);">
                                @log.EntityType
                                @if (log.EntityId != null)
                                {
                                    <span> #@log.EntityId</span>
                                }
                            </td>
                            <td>
                                <span style="font-family: 'Courier New', monospace; font-size: 10px; color: var(--amber-dark); display: block; max-width: 120px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                                    @log.BlockchainHash
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (pages > 1)
        {
            int startPg = Math.Max(1, pg - 2);
            int endPg   = Math.Min(pages, pg + 2);
            <div class="card-footer">
                <div class="pagination-bar">
                    @if (pg > 1)
                    {
                        <a asp-action="AuditTrail" asp-route-pg="@(pg - 1)" asp-route-search="@ViewBag.Search"
                           class="page-btn">← Prev</a>
                    }
                    @for (int n = startPg; n <= endPg; n++)
                    {
                        <a asp-action="AuditTrail" asp-route-pg="@n" asp-route-search="@ViewBag.Search"
                           class="page-btn @(n == pg ? "active" : "")">@n</a>
                    }
                    @if (pg < pages)
                    {
                        <a asp-action="AuditTrail" asp-route-pg="@(pg + 1)" asp-route-search="@ViewBag.Search"
                           class="page-btn">Next →</a>
                    }
                    <span style="margin-left: 12px; font-size: 13px; color: var(--text-muted);">
                        Page @pg of @pages
                    </span>
                </div>
            </div>
        }
    }
    else
    {
        <div class="empty-state">
            <div class="empty-state-icon">📋</div>
            <div class="empty-state-title">No audit records found</div>
            <div class="empty-state-text">Audit entries are created as users perform actions in the system.</div>
        </div>
    }
</div>
