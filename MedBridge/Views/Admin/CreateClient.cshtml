@using MedBridge.ViewModels.Admin
@model CreateClientViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Add Client";
}

<div class="page-header">
    <div>
        <h1 class="page-heading">Add Client</h1>
        <p class="page-subheading">Register a new hospital, clinic or medical practice</p>
    </div>
    <a asp-action="Clients" class="btn btn-outline">← Back to Clients</a>
</div>

<div class="card" style="max-width: 720px;">
    <div class="card-body">
        <form asp-action="CreateClient" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

            <div class="form-section-title">Organisation Details</div>
            <div class="form-grid">
                <div class="form-group">
                    <label class="form-label" asp-for="Name">Organisation Name <span class="required">*</span></label>
                    <input class="form-control" asp-for="Name" placeholder="e.g. Netcare Milpark Hospital" />
                    <span asp-validation-for="Name" class="field-validation-error"></span>
                </div>
                <div class="form-group">
                    <label class="form-label" asp-for="Type">Type <span class="required">*</span></label>
                    <select class="form-control form-select" asp-for="Type">
                        <option value="Hospital">Hospital</option>
                        <option value="Clinic">Clinic</option>
                        <option value="Practice">Medical Practice</option>
                        <option value="Day Hospital">Day Hospital</option>
                        <option value="Pharmacy">Pharmacy</option>
                    </select>
                    <span asp-validation-for="Type" class="field-validation-error"></span>
                </div>
                <div class="form-group">
                    <label class="form-label" asp-for="RegistrationNo">Registration Number</label>
                    <input class="form-control" asp-for="RegistrationNo" placeholder="e.g. 2001/012345/07" />
                </div>
            </div>

            <div class="form-section">
                <div class="form-section-title">Contact Details</div>
                <div class="form-group">
                    <label class="form-label" asp-for="Address">Address</label>
                    <textarea class="form-control" asp-for="Address" rows="2"
                              placeholder="Street, City, Province, Postal Code"></textarea>
                </div>
                <div class="form-grid">
                    <div class="form-group">
                        <label class="form-label" asp-for="Phone">Phone</label>
                        <input class="form-control" asp-for="Phone" type="tel" placeholder="+27 11 000 0000" />
                        <span asp-validation-for="Phone" class="field-validation-error"></span>
                    </div>
                    <div class="form-group">
                        <label class="form-label" asp-for="Email">Email</label>
                        <input class="form-control" asp-for="Email" type="email" placeholder="info@hospital.co.za" />
                        <span asp-validation-for="Email" class="field-validation-error"></span>
                    </div>
                    <div class="form-group">
                        <label class="form-label" asp-for="Website">Website</label>
                        <input class="form-control" asp-for="Website" type="url" placeholder="https://www.hospital.co.za" />
                        <span asp-validation-for="Website" class="field-validation-error"></span>
                    </div>
                </div>
            </div>

            <div style="margin-top: 24px; display: flex; gap: 10px;">
                <button type="submit" class="btn btn-primary">Create Client</button>
                <a asp-action="Clients" class="btn btn-outline">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
