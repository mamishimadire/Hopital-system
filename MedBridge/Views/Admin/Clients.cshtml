@using MedBridge.ViewModels.Admin
@model IEnumerable<ClientListViewModel>
@{
    Layout = "_Layout";
    ViewData["Title"] = "Clients";
}

<div class="page-header">
    <div>
        <h1 class="page-heading">Clients</h1>
        <p class="page-subheading">Hospitals, clinics and medical practices</p>
    </div>
    <a asp-action="CreateClient" class="btn btn-primary">+ Add Client</a>
</div>

<!-- Filters -->
<form method="get" asp-action="Clients">
    <div class="filter-bar">
        <div class="search-box">
            <input type="text" name="search" value="@ViewBag.Search" placeholder="Search clients…" />
            <button type="submit">🔍</button>
        </div>
        @if (!string.IsNullOrEmpty(ViewBag.Search as string))
        {
            <a asp-action="Clients" class="btn btn-outline btn-sm">Clear</a>
        }
    </div>
</form>

<div class="card">
    <div class="card-header">
        <span class="card-title">@Model.Count() clients</span>
    </div>
    @if (Model.Any())
    {
        <div class="table-container">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Organisation</th>
                        <th>Type</th>
                        <th>Reg No</th>
                        <th>Contact</th>
                        <th>Staff</th>
                        <th>Patients</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in Model)
                    {
                        <tr>
                            <td>
                                <div style="font-weight: 500;">@c.Name</div>
                                <div style="font-size: 12px; color: var(--text-muted);">
                                    Since @c.CreatedAt.ToString("MMM yyyy")
                                </div>
                            </td>
                            <td><span class="badge badge-pending" style="background: #EFF6FF; color: #1D4ED8;">@c.Type</span></td>
                            <td style="font-size: 12px; color: var(--text-muted);">@(c.RegistrationNo ?? "—")</td>
                            <td style="font-size: 13px;">
                                @if (!string.IsNullOrEmpty(c.Phone))
                                {
                                    <div>@c.Phone</div>
                                }
                                @if (!string.IsNullOrEmpty(c.Email))
                                {
                                    <div style="font-size: 12px; color: var(--text-muted);">@c.Email</div>
                                }
                            </td>
                            <td style="text-align: center;">@c.StaffCount</td>
                            <td style="text-align: center;">@c.PatientCount</td>
                            <td>
                                @if (c.IsActive)
                                {
                                    <span class="badge badge-active">Active</span>
                                }
                                else
                                {
                                    <span class="badge badge-inactive">Inactive</span>
                                }
                            </td>
                            <td class="actions">
                                <form asp-action="ToggleClientStatus" asp-route-id="@c.Id"
                                      method="post" style="display:inline;">
                                    @Html.AntiForgeryToken()
                                    <button type="submit"
                                            class="btn-icon @(c.IsActive ? "danger" : "")"
                                            title="@(c.IsActive ? "Deactivate" : "Activate")"
                                            data-confirm="@(c.IsActive ? "Deactivate this client?" : "Activate this client?")">
                                        @(c.IsActive ? "🚫" : "✅")
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="empty-state">
            <div class="empty-state-icon">🏥</div>
            <div class="empty-state-title">No clients found</div>
            <div class="empty-state-text">Add your first hospital or clinic to get started.</div>
        </div>
    }
</div>
