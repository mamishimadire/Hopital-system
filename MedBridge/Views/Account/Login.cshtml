@model MedBridge.ViewModels.Account.LoginViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Sign In";
}

<div class="login-page">
    <div class="login-card">
        <div class="login-logo">
            <span class="login-brand">MedBridge</span>
            <span class="login-brand-sub">EMR &amp; Procurement Platform</span>
        </div>

        <h2 class="login-title">Welcome back</h2>
        <p class="login-subtitle">Sign in to continue to your workspace</p>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="login-error">
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <div>@error.ErrorMessage</div>
                }
            </div>
        }

        <form asp-action="Login" asp-controller="Account" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="ReturnUrl" />

            <div class="form-group">
                <label class="form-label" asp-for="Email">Email address</label>
                <input class="form-control" asp-for="Email" type="email"
                       placeholder="you@organisation.com" autocomplete="username" autofocus />
                <span asp-validation-for="Email" class="field-validation-error"></span>
            </div>

            <div class="form-group">
                <label class="form-label" asp-for="Password">Password</label>
                <input class="form-control" asp-for="Password" type="password"
                       placeholder="••••••••" autocomplete="current-password" />
                <span asp-validation-for="Password" class="field-validation-error"></span>
            </div>

            <div class="form-check" style="margin-bottom: 20px;">
                <input class="form-check-input" asp-for="RememberMe" type="checkbox" />
                <label class="form-check-label" asp-for="RememberMe">Keep me signed in</label>
            </div>

            <button type="submit" class="login-btn">Sign In</button>
        </form>

        <p style="margin-top: 16px; text-align: center; font-size: 13px;">
            <a asp-action="ForgotPassword" style="color: var(--text-muted);">Forgot password?</a>
        </p>
        <p style="margin-top: 8px; font-size: 11px; color: var(--text-muted); text-align: center;">
            Protected by MedBridge Blockchain Audit Trail
        </p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
