@model MedBridge.ViewModels.Account.ChangePasswordViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Change Password";
}

<div class="page-header">
    <div>
        <h1 class="page-heading">Change Password</h1>
        <p class="page-subheading">Your password must be changed before you can continue.</p>
    </div>
</div>

<div class="card" style="max-width: 460px;">
    <div class="card-body">
        <div class="info-banner" style="margin-bottom: 20px;">
            🔑 Password policy: minimum 8 characters, must include uppercase, lowercase, a digit, and a special character.
        </div>

        <form asp-action="ChangePassword" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

            <div class="form-group">
                <label class="form-label" asp-for="CurrentPassword">Current Password</label>
                <input class="form-control" asp-for="CurrentPassword" type="password" autofocus />
                <span asp-validation-for="CurrentPassword" class="field-validation-error"></span>
            </div>

            <div class="form-group">
                <label class="form-label" asp-for="NewPassword">New Password</label>
                <input class="form-control" asp-for="NewPassword" type="password"
                       placeholder="Min. 8 chars, upper/lower/digit/symbol" />
                <span asp-validation-for="NewPassword" class="field-validation-error"></span>
            </div>

            <div class="form-group">
                <label class="form-label" asp-for="ConfirmPassword">Confirm New Password</label>
                <input class="form-control" asp-for="ConfirmPassword" type="password" />
                <span asp-validation-for="ConfirmPassword" class="field-validation-error"></span>
            </div>

            <div style="margin-top: 20px;">
                <button type="submit" class="btn btn-primary" style="width: 100%; justify-content: center;">
                    Update Password
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
