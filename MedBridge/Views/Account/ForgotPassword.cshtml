@model MedBridge.ViewModels.Account.ForgotPasswordViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Forgot Password";
}

<div class="login-page">
    <div class="login-card">
        <div class="login-logo">
            <span class="login-brand">MedBridge</span>
            <span class="login-brand-sub">EMR &amp; Procurement Platform</span>
        </div>

        <h2 class="login-title">Reset Password</h2>
        <p class="login-subtitle">Enter your email address and we'll send you a reset link.</p>

        <form asp-action="ForgotPassword" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="login-error"></div>

            <div class="form-group">
                <label class="form-label" asp-for="Email">Email Address</label>
                <input class="form-control" asp-for="Email" type="email"
                       placeholder="your@email.com" autofocus />
                <span asp-validation-for="Email" class="field-validation-error"></span>
            </div>

            <button type="submit" class="login-btn">Send Reset Link</button>
        </form>

        <p style="margin-top: 20px; text-align: center; font-size: 13px;">
            <a asp-action="Login">← Back to Sign In</a>
        </p>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
