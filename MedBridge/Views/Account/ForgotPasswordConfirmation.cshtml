@{
    Layout = "_Layout";
    ViewData["Title"] = "Check Your Email";
}

<div class="login-page">
    <div class="login-card" style="text-align: center;">
        <div style="font-size: 56px; margin-bottom: 16px;">📧</div>
        <h2 class="login-title">Check your inbox</h2>
        <p style="color: var(--text-muted); font-size: 14px; margin-bottom: 24px;">
            @(TempData["Info"] ?? "If your email is registered, a password reset link has been sent.")
        </p>
        <p style="font-size: 13px; color: var(--text-muted);">
            Didn't receive it? Check your spam folder, or
            <a asp-action="ForgotPassword">try again</a>.
        </p>
        <div style="margin-top: 24px;">
            <a asp-action="Login" class="btn btn-dark" style="width: 100%; justify-content: center;">
                ← Back to Sign In
            </a>
        </div>
    </div>
</div>
