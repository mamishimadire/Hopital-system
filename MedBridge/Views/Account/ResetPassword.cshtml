@model MedBridge.ViewModels.Account.ResetPasswordViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Set New Password";
}

<div class="login-page">
    <div class="login-card">
        <div class="login-logo">
            <span class="login-brand">MedBridge</span>
            <span class="login-brand-sub">EMR &amp; Procurement Platform</span>
        </div>

        <h2 class="login-title">Set New Password</h2>
        <p class="login-subtitle">Choose a strong password for your account.</p>

        <form asp-action="ResetPassword" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Email" />
            <input type="hidden" asp-for="Token" />
            <div asp-validation-summary="ModelOnly" class="login-error"></div>

            <div class="form-group">
                <label class="form-label" asp-for="NewPassword">New Password</label>
                <input class="form-control" asp-for="NewPassword" type="password"
                       placeholder="Min. 8 chars, upper/lower/digit/symbol" autofocus />
                <span asp-validation-for="NewPassword" class="field-validation-error"></span>
            </div>

            <div class="form-group">
                <label class="form-label" asp-for="ConfirmPassword">Confirm New Password</label>
                <input class="form-control" asp-for="ConfirmPassword" type="password" placeholder="••••••••" />
                <span asp-validation-for="ConfirmPassword" class="field-validation-error"></span>
            </div>

            <button type="submit" class="login-btn">Save New Password</button>
        </form>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
