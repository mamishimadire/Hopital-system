@using MedBridge.Models
@{
    Layout = "_Layout";
    ViewData["Title"] = "Dashboard";
    var recentRx    = ViewBag.RecentRx    as List<Prescription>  ?? new();
    var stockAlerts = ViewBag.StockAlerts as List<Medication>     ?? new();
}

<div class="page-header">
    <div>
        <h1 class="page-heading">Dashboard</h1>
        <p class="page-subheading">@ViewBag.Role — @DateTime.Now.ToString("dddd, dd MMMM yyyy")</p>
    </div>
</div>

<!-- KPI Stats -->
<div class="stats-grid">
    <div class="stat-card">
        <div class="stat-label">Pending Rx</div>
        <div class="stat-value warning">@ViewBag.PendingRx</div>
        <div class="stat-footer">Prescriptions to dispense</div>
    </div>
    <div class="stat-card">
        <div class="stat-label">Low Stock</div>
        <div class="stat-value amber">@ViewBag.LowStock</div>
        <div class="stat-footer">Items below minimum</div>
    </div>
    <div class="stat-card">
        <div class="stat-label">Out of Stock</div>
        <div class="stat-value danger">@ViewBag.OutOfStock</div>
        <div class="stat-footer">Zero quantity items</div>
    </div>
    <div class="stat-card">
        <div class="stat-label">Pending PRs</div>
        <div class="stat-value info">@ViewBag.PendingPR</div>
        <div class="stat-footer">Requisitions awaiting approval</div>
    </div>
    <div class="stat-card">
        <div class="stat-label">Approved POs</div>
        <div class="stat-value">@ViewBag.PendingPO</div>
        <div class="stat-footer">Orders ready to send</div>
    </div>
    @if (User.IsInRole("FinanceManager"))
    {
        <div class="stat-card">
            <div class="stat-label">Finance Inbox</div>
            <div class="stat-value amber">@ViewBag.UnreadFinance</div>
            <div class="stat-footer">Unread documents</div>
        </div>
    }
</div>

<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 20px;">
    <!-- Recent Prescriptions -->
    <div class="card">
        <div class="card-header">
            <span class="card-title">Recent Prescriptions</span>
            @if (User.IsInRole("Doctor"))
            {
                <a asp-controller="Prescription" asp-action="Create" class="btn btn-sm btn-primary">+ New Rx</a>
            }
            else if (User.IsInRole("Pharmacist") || User.IsInRole("Nurse"))
            {
                <a asp-controller="Dispense" asp-action="Queue" class="btn btn-sm btn-primary">Dispense Queue</a>
            }
        </div>
        @if (recentRx.Any())
        {
            <div class="table-container">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Patient</th>
                            <th>Medication</th>
                            <th>Date</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var rx in recentRx)
                        {
                            <tr>
                                <td style="font-weight: 500; font-size: 13px;">
                                    @(rx.Patient?.FullName ?? "—")
                                </td>
                                <td style="font-size: 13px;">
                                    @(rx.Medication?.Name ?? "—")
                                    @if (!string.IsNullOrEmpty(rx.Dosage))
                                    {
                                        <div style="font-size: 11px; color: var(--text-muted);">@rx.Dosage</div>
                                    }
                                </td>
                                <td style="font-size: 12px; color: var(--text-muted); white-space: nowrap;">
                                    @rx.PrescribedAt.ToLocalTime().ToString("dd MMM HH:mm")
                                </td>
                                <td>
                                    @switch (rx.Status)
                                    {
                                        case PrescriptionStatus.Pending:
                                            <span class="badge badge-pending">Pending</span>
                                            break;
                                        case PrescriptionStatus.Dispensed:
                                            <span class="badge badge-dispensed">Dispensed</span>
                                            break;
                                        case PrescriptionStatus.Cancelled:
                                            <span class="badge badge-cancelled">Cancelled</span>
                                            break;
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="empty-state" style="padding: 32px;">
                <div class="empty-state-icon" style="font-size: 32px;">📝</div>
                <div class="empty-state-title" style="font-size: 14px;">No recent prescriptions</div>
            </div>
        }
    </div>

    <!-- Stock Alerts -->
    <div class="card">
        <div class="card-header">
            <span class="card-title">Stock Alerts</span>
            @if (User.IsInRole("ProcurementOfficer") || User.IsInRole("HeadOfProcurement"))
            {
                <a asp-controller="Procurement" asp-action="CreateRequisition" class="btn btn-sm btn-outline">+ Raise PR</a>
            }
            else
            {
                <a asp-controller="Medication" asp-action="Index" class="btn btn-sm btn-outline">View All</a>
            }
        </div>
        @if (stockAlerts.Any())
        {
            <div class="table-container">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Medication</th>
                            <th>Stock</th>
                            <th>Min</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var med in stockAlerts)
                        {
                            var pct = med.MinimumQuantity > 0
                                ? (int)Math.Min(100, (double)med.Quantity / med.MinimumQuantity * 100)
                                : 0;
                            var cls = med.Quantity == 0 ? "critical" : pct <= 50 ? "low" : "";
                            <tr>
                                <td>
                                    <div style="font-weight: 500; font-size: 13px;">@med.Name</div>
                                    <div style="font-size: 11px; color: var(--text-muted);">@med.Code</div>
                                </td>
                                <td>
                                    <div class="stock-bar">
                                        <div class="stock-progress">
                                            <div class="stock-progress-fill @cls"
                                                 style="width: @pct%"></div>
                                        </div>
                                        <span style="font-size: 12px; font-weight: 600; min-width: 28px; text-align: right;">
                                            @med.Quantity
                                        </span>
                                    </div>
                                </td>
                                <td style="font-size: 12px; color: var(--text-muted);">@med.MinimumQuantity</td>
                                <td>
                                    @if (med.Quantity == 0)
                                    {
                                        <span class="badge badge-out">Out</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-low">Low</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="empty-state" style="padding: 32px;">
                <div class="empty-state-icon" style="font-size: 32px;">✓</div>
                <div class="empty-state-title" style="font-size: 14px;">Stock levels are healthy</div>
            </div>
        }
    </div>
</div>

<!-- Quick Links by Role -->
<div class="card">
    <div class="card-header">
        <span class="card-title">Quick Access</span>
    </div>
    <div class="card-body" style="display: flex; gap: 12px; flex-wrap: wrap;">
        @if (User.IsInRole("Doctor"))
        {
            <a asp-controller="Patient" asp-action="Index" class="btn btn-outline">👤 Patients</a>
            <a asp-controller="Prescription" asp-action="Create" class="btn btn-primary">📝 New Prescription</a>
        }
        @if (User.IsInRole("Pharmacist") || User.IsInRole("Nurse"))
        {
            <a asp-controller="Dispense" asp-action="Queue" class="btn btn-primary">💊 Dispense Queue</a>
            <a asp-controller="Medication" asp-action="Index" class="btn btn-outline">📦 Inventory</a>
        }
        @if (User.IsInRole("ProcurementOfficer"))
        {
            <a asp-controller="Procurement" asp-action="CreateRequisition" class="btn btn-primary">📋 New Requisition</a>
            <a asp-controller="Procurement" asp-action="Requisitions" class="btn btn-outline">View PRs</a>
        }
        @if (User.IsInRole("HeadOfProcurement") || User.IsInRole("HeadOfSupplyChain"))
        {
            <a asp-controller="Procurement" asp-action="Requisitions" class="btn btn-outline">📋 Requisitions</a>
            <a asp-controller="Procurement" asp-action="Orders" class="btn btn-outline">🛒 Purchase Orders</a>
        }
        @if (User.IsInRole("ReceivingClerk"))
        {
            <a asp-controller="Receiving" asp-action="Index" class="btn btn-primary">📦 Receive Goods</a>
        }
        @if (User.IsInRole("FinanceManager"))
        {
            <a asp-controller="Finance" asp-action="Inbox" class="btn btn-primary">📨 Finance Inbox</a>
            <a asp-controller="Finance" asp-action="Payments" class="btn btn-outline">💳 Payments</a>
        }
    </div>
</div>
