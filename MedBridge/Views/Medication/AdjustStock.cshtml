@model MedBridge.Models.Medication
@{
    Layout = "_Layout";
    ViewData["Title"] = "Adjust Stock";
}

<div class="page-header">
    <div>
        <h1 class="page-heading">Adjust Stock</h1>
        <p class="page-subheading">@Model.Name — blockchain-audited adjustment</p>
    </div>
    <a asp-action="Index" class="btn btn-outline">← Back</a>
</div>

<div class="card" style="max-width: 560px;">
    <div class="card-body">
        <div class="info-banner" style="margin-bottom: 16px;">
            Current stock: <strong>@Model.Quantity @Model.Unit</strong>
        </div>
        <form asp-action="AdjustStock" asp-route-id="@Model.Id" method="post">
            @Html.AntiForgeryToken()
            <div class="form-group">
                <label class="form-label">Adjustment Quantity <span style="color:var(--danger)">*</span></label>
                <input type="number" name="adjustment" class="form-control"
                       placeholder="Use positive to add, negative to remove (e.g. -5)" required />
                <div style="font-size: 12px; color: var(--text-muted); margin-top: 4px;">
                    Positive = restock &nbsp;|&nbsp; Negative = write-off / wastage
                </div>
            </div>
            <div class="form-group">
                <label class="form-label">Reason <span style="color:var(--danger)">*</span></label>
                <select name="reason" class="form-control form-select" required>
                    <option value="">— Select reason —</option>
                    <option>Goods received from supplier</option>
                    <option>Stock count correction</option>
                    <option>Expired — disposed</option>
                    <option>Damaged — written off</option>
                    <option>Returned to supplier</option>
                    <option>Transfer from another ward</option>
                    <option>Initial stock entry</option>
                    <option>Other</option>
                </select>
            </div>
            <div style="display: flex; gap: 10px; margin-top: 16px;">
                <button type="submit" class="btn btn-primary">Apply Adjustment</button>
                <a asp-action="Index" class="btn btn-outline">Cancel</a>
            </div>
        </form>
    </div>
</div>
